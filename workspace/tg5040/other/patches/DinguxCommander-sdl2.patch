diff --git a/src/def.h b/src/def.h
index fc6e531..2ad2013 100644
--- a/src/def.h
+++ b/src/def.h
@@ -110,9 +110,9 @@
 #define MYKEY_OPEN          1	// A
 #define MYKEY_PARENT        0	// B
 #define MYKEY_OPERATION     3	// X
-#define MYKEY_SELECT        8	// SELECT
-#define MYKEY_TRANSFER      9	// START
-#define MYKEY_MENU			19	// MENU
+#define MYKEY_SELECT        6	// SELECT
+#define MYKEY_TRANSFER      7	// START
+#define MYKEY_MENU			8	// MENU (BTN_MODE; the pad only has joy buttons 0..10, 19 never fired)
 #define PATH_DEFAULT        "/"
 #define FILE_SYSTEM         "/dev/mmcblk1p1"
 #elif defined(PLATFORM_MY282)
diff --git a/src/window.cpp b/src/window.cpp
index 23ec08b..a0e5413 100644
--- a/src/window.cpp
+++ b/src/window.cpp
@@ -52,6 +52,17 @@ const int CWindow::execute(void)
             }
             else if(l_event.type == SDL_JOYBUTTONDOWN)
             {
+                // MinUI Zero: the physical MENU button quits, everywhere. Users could not
+                // find the exit (it hid in the Y-button system menu); MENU-quits matches how
+                // every other screen in the firmware behaves. The pushed SDL_QUIT re-inserts
+                // itself in the handler above, unwinding every nested dialog cleanly.
+                if (l_event.jbutton.button == MYKEY_MENU)
+                {
+                    SDL_Event l_quit;
+                    l_quit.type = SDL_QUIT;
+                    SDL_PushEvent(&l_quit);
+                    continue;
+                }
                 printf("joy:%d\n",l_event.jbutton.button); fflush(stdout);
                 SDL_Event key_event;
 				key_event.key.keysym.sym = l_event.jbutton.button==MYKEY_MENU?MYKEY_SYSTEM:l_event.jbutton.button;
