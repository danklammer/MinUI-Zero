# miyoomini — SigmaStar SSD202D, dual Cortex-A7 (ARMv7, armhf), NEON/VFPv4.
# ARCH was EMPTY here (inherited from upstream): a generic ARM build with no -mcpu and no explicit
# -O level — the same class of bug the tg5040 sweep caught (frontend silently -Os, D21).
# CONFIRMED on-device 2026-07-24: /proc/cpuinfo reports "neon vfpv4", CPU part 0xc07 (Cortex-A7).
ARCH = -O3 -mcpu=cortex-a7 -mtune=cortex-a7 -mfpu=neon-vfpv4 -mfloat-abi=hard

# Governor tuning for this SoC (see the GOV_PLATFORM_MIYOOMINI block in governor.c):
#  - no schedutil, so the commanded ceiling IS the clock (userspace + scaling_setspeed)
#  - the OPP ladder steps 400/600/800/1000 in 200 MHz, so tg5040's 216 MHz stride would skip steps
ARCH += -DGOV_PLATFORM_MIYOOMINI -DGOV_STEP_KHZ=200000

# SDL2: the device SDL2 is the only build with the MMIYOO audio driver (SDL 1.2 audio here needs
# libpadsp, which SEGFAULTS binaries from this toolchain). Provision with
# tools/provision-miyoomini-sdl2.sh, then build in the miyoomini-toolchain-sdl2 image.
SDL = SDL2
LIBS = -lmi_sys -lmi_gfx -lpthread -Wl,--allow-shlib-undefined -Wl,--unresolved-symbols=ignore-in-shared-libs
