# h700 rootfs ALLOWLIST. Every path here is KEPT; everything else in the donor is dropped.
#
# WHY AN ALLOWLIST. Our shipping image is built by DENYLIST: rdump the muOS rootfs, then delete what
# we remembered to name. That only removes what someone thought of, which is how bluetoothd (1.4MB)
# and dbus-daemon are still sitting in a rootfs for a device with no Bluetooth feature. Enumerating
# what we keep makes the omissions loud instead of silent. The idea is BaseOS's
# (github.com/pvaibhav/BaseOS, docs/01-rootfs-and-init.md); the contents below are ours, computed
# from our own binaries.
#
# HOW THIS LIST WAS DERIVED, not guessed: ldd over minui.elf, minarch.elf and libmsettings.so on the
# device (2026-08-26), plus the things ldd cannot see because they are dlopened or exec'd. 34 closure
# entries, 53.0MB, of which libmali alone is 42.5MB.
#
# LAYOUT NOTE: this donor is NOT merged-/usr (/bin, /lib, /sbin are real directories) and has no
# multiarch dir, so paths are literal.
#
# Syntax: one path per line. A trailing / means the whole directory. '#' comments.

# ---- dynamic loader + glibc core -------------------------------------------------------------
# The interp symlink MUST exist or every dynamic binary on the system is dead (BaseOS learned this
# the hard way; nothing reports it, the device just does not boot).
/lib/ld-linux-aarch64.so.1
/lib/libc.so.6
/lib/libm.so.6
/lib/libdl.so.2
/lib/libpthread.so.0
/lib/librt.so.1
/lib/libgcc_s.so.1
/usr/lib/libstdc++.so.6
/usr/lib/libz.so.1

# ---- SDL2 and the text/image stack it pulls ---------------------------------------------------
/usr/lib/libSDL2-2.0.so.0
/usr/lib/libSDL2_image-2.0.so.0
/usr/lib/libSDL2_ttf-2.0.so.0
/usr/lib/libfreetype.so.6
/usr/lib/libpng16.so.16
/usr/lib/libbz2.so.1.0
/usr/lib/libharfbuzz.so.0
/usr/lib/libbrotlidec.so.1
/usr/lib/libbrotlicommon.so.1
/usr/lib/libglib-2.0.so.0
/usr/lib/libpcre2-8.so.0

# ---- audio: ALSA direct, no sound server ------------------------------------------------------
# pipewire is deliberately absent; asound.conf routes "default" straight to the codec (plug -> hw).
/usr/lib/libasound.so.2
/usr/share/alsa/
# NOT /usr/lib/alsa-lib/. The donor keeps ALSA plugin modules there, and the only two it has are
# libasound_module_{ctl,pcm}_pipewire.so, which reference a libpipewire we deliberately delete.
# The allowlist build caught them as unresolved on its first run (2026-08-27) - the denylist image
# has been shipping two broken plugins pointing at a library that is not there. We need NO plugins:
# /etc/asound.conf uses only `type plug` and `type hw`, both built into libasound, and the shipping
# device runs with that directory empty and audio working.
/etc/asound.conf
/usr/sbin/alsactl
/usr/bin/amixer

# ---- wifi (optional at runtime: no wifi.txt on the card means none of this ever runs) ----------
/usr/sbin/wpa_supplicant
/usr/sbin/wpa_cli
/sbin/dhcpcd
/usr/lib/libnl-3.so.200
/usr/lib/libnl-genl-3.so.200
/usr/lib/libnl-route-3.so.200
/usr/lib/libssl.so.3
/usr/lib/libcrypto.so.3
/lib/firmware/
# wpa_cli links readline, which links ncurses/tinfo. Small, and dropping wpa_cli to save them would
# cost us the only interactive wifi debugging tool on the device.
/usr/lib/libreadline.so.8
/usr/lib/libncursesw.so.6
/usr/lib/libtinfo.so.6

# ---- first-boot partition expander -------------------------------------------------------------
# expand-roms.sh grows the FAT32 ROMS partition to fill the card on first boot. It needs parted and
# partx; fdisk, mkfs.vfat and partprobe come from busybox. Verified deps only (readelf), not guessed:
# parted -> libparted, libuuid, libreadline, libtinfo (last two already above for wpa_cli);
# partx  -> libblkid, libsmartcols. 592KB all in, for the difference between a 68MB ROMS partition
# and the user's whole card. The script exits cleanly if a tool is absent, so this is not a boot
# risk, only a silently unexpanded card.
/usr/sbin/parted
/usr/sbin/partx
/usr/lib/libparted.so.2
# These three live in /lib, not /usr/lib, in this donor (there is no merged-/usr here). The build
# caught the wrong paths immediately, which is the allowlist doing its job.
/lib/libuuid.so.1
/lib/libblkid.so.1
/lib/libsmartcols.so.1

# ---- libraries needed by CARD-side binaries -----------------------------------------------------
# The closure check scans the ROOTFS, but the card carries executables too (minui.elf, minarch.elf,
# the libretro cores, dropbearmulti) and the rootfs has to satisfy THEM as well. dropbearmulti needs
# these two and nothing in the rootfs did, so ssh silently never started on the first allowlist boot
# (2026-08-27): the device was on wifi with no way in. The build now checks the card payload too.
/lib/libutil.so.1
/lib/libcrypt.so.1
# picodrive links Vorbis for Sega CD audio. Without these the CORE fails to load outright, which
# would have taken Genesis, Master System and Game Gear down together. Caught by the card-payload
# gate the moment it existed, rather than on hardware three systems later.
/usr/lib/libvorbisfile.so.3
/usr/lib/libvorbis.so.0
/usr/lib/libogg.so.0

# ---- userland ---------------------------------------------------------------------------------
# One static busybox provides init, sh, mount, insmod, udhcpc, killall and the first-boot expand
# tools. Everything else in /bin and /sbin goes.
/bin/busybox

# ---- kernel modules ---------------------------------------------------------------------------
# Only what is actually loaded (lsmod on-device: 8821cs, mali_kbase). backlight/lcd are built in.
/lib/modules/4.9.170/kernel/drivers/net/wireless/rtl8821cs/8821cs.ko
# mali_kbase: see the GPU note at the bottom. Kept by default, dropped by H700_NO_GPU=1.
/lib/modules/4.9.170/kernel/drivers/video/gpu/mali_kbase.ko

# ---- /etc -------------------------------------------------------------------------------------
/etc/passwd
/etc/group
/etc/nsswitch.conf
/etc/ld.so.conf
/etc/hosts
/etc/hostname
/etc/protocols
/etc/services
# ld.so.cache is REGENERATED by the build (ldconfig), never harvested: a stale cache from the donor
# describes libraries we just deleted.

# ---- small data -------------------------------------------------------------------------------
/usr/share/terminfo/
/usr/share/zoneinfo/

# ---- the GPU blob -----------------------------------------------------------------------------
# MEASURED 2026-08-26: our stack NEVER loads this. We run SDL_VIDEODRIVER=dummy, that driver is
# absent from this SDL build so video init fails outright, and we present through the DE hardware
# scaler. Checked both processes, the menu and a running game: zero libmali/libEGL/libGLES mappings,
# no /dev/mali0 fd in either.
#
# It is kept anyway, by default, for THIRD-PARTY PAKS: community paks are the opt-in feature rail
# and a NextUI-style pak may well want GLES. Dropping it takes the rootfs from ~62MB to ~20MB, so
# the build exposes H700_NO_GPU=1 to omit this block and measure that.
/usr/lib/libmali.so
/usr/lib/libEGL.so
/usr/lib/libEGL.so.1
/usr/lib/libGLESv1_CM.so
/usr/lib/libGLESv1_CM.so.1
/usr/lib/libGLESv2.so
/usr/lib/libGLESv2.so.2
