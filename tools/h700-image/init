#!/bin/sh
# MinUI Zero h700 — PID 1. The whole OS: mount, governor, then the launch loop.
# The muOS-derived ramdisk switch_roots here after mounting p5 (see the extracted ramdisk init:
# `[ -x /mnt/init ] && exec switch_root /mnt /init`). /dev arrives populated (moved from the
# ramdisk's devtmpfs).
#
# DEBUGGABILITY RULES (v2, after the first flash test powered straight off and took its logs
# with it): every step breadcrumbs to p2 — the FAT partition a Mac can read — and failure NEVER
# powers off; it parks with the logs flushed. v1's "minui exited => poweroff" made a boot
# failure indistinguishable from a power fault.

/bin/busybox --install -s /bin 2>/dev/null

mount -t proc proc /proc 2>/dev/null
mount -t sysfs sysfs /sys 2>/dev/null
mount -t debugfs debugfs /sys/kernel/debug 2>/dev/null   # dispdbg brightness lives here
mount -t devpts devpts /dev/pts 2>/dev/null
mount -t tmpfs tmpfs /tmp 2>/dev/null
mount -t tmpfs tmpfs /run 2>/dev/null

# breadcrumb log on the Mac-readable FAT partition
mkdir -p /mnt/log
mount /dev/mmcblk0p2 /mnt/log 2>/dev/null
LOG=/mnt/log/minui-zero-boot.log
log() {
	echo "[$(cut -d" " -f1 /proc/uptime 2>/dev/null)] $*" >> "$LOG" 2>/dev/null
	sync
}
: > "$LOG" 2>/dev/null
log "MinUI Zero h700 init"

echo schedutil > /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null
log "governor: $(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null)"

mkdir -p /mnt/mmc
if mount -o rw,noatime /dev/mmcblk0p6 /mnt/mmc 2>/dev/null; then
	log "p6 mounted"
else
	log "p6 MOUNT FAILED"
fi

export PLATFORM=h700
export SDCARD_PATH=/mnt/mmc
export SYSTEM_PATH=/mnt/mmc/.system/h700
export USERDATA_PATH=/mnt/mmc/.userdata/h700
export LOGS_PATH=/mnt/mmc/.userdata/h700/logs
export SHARED_USERDATA_PATH=/mnt/mmc/.userdata/shared
export SAVES_PATH=/mnt/mmc/Saves
export BIOS_PATH=/mnt/mmc/Bios
export CORES_PATH=/mnt/mmc/.system/h700/cores
export LD_LIBRARY_PATH=/mnt/mmc/.system/h700/lib:/usr/lib:/lib
export SDL_AUDIODRIVER=alsa
# dummy video: our present path is the DE layer, SDL video is unused — and SDL real video
# drivers dlopen libudev (absent on this rootfs) and SEGFAULT (flash test 2 breadcrumbs,
# rc=139 with "Failed loading libudev.so.0"). The dummy driver needs nothing and crashes never.
export SDL_VIDEODRIVER=dummy
mkdir -p "$LOGS_PATH" "$SAVES_PATH" "$SHARED_USERDATA_PATH/.minui"

M="$SYSTEM_PATH/bin/minui.elf"
if [ -x "$M" ]; then
	log "minui present: $(ls -la "$M" 2>/dev/null)"
	log "loader check: $(LD_TRACE_LOADED_OBJECTS=1 "$M" 2>&1 | grep "not found" | tr "\n" ";")"
else
	log "minui MISSING at $M; p6 root: $(ls /mnt/mmc 2>/dev/null | tr "\n" " ")"
fi

if [ -x /usr/sbin/dropbearmulti ]; then
	mkdir -p /etc/dropbear
	[ -f /etc/dropbear/dropbear_ed25519_host_key ] || /usr/sbin/dropbearmulti dropbearkey -t ed25519 -f /etc/dropbear/dropbear_ed25519_host_key >/dev/null 2>&1
	/usr/sbin/dropbearmulti dropbear -R 2>/dev/null
	log "dropbear started"
fi

# background syncer: minui logs stream STRAIGHT to the FAT partition, so even a HANG leaves
# its trace readable on a Mac (flash test 3: minui hung, and its tmpfs log died with the power)
( while : ; do sync; sleep 2; done ) &

# the launch loop IS the OS. Crashes and quits both land back in minui; a broken minui parks
# with logs flushed instead of powering off.
cd /tmp
FAILS=0
while : ; do
	rm -f /tmp/next
	"$M" > /mnt/log/minui-live.log 2>&1
	RC=$?
	if [ -f /tmp/next ]; then
		FAILS=0
		CMD=$(cat /tmp/next)
		log "launch: $CMD"
		sh -c "$CMD"
	else
		FAILS=$((FAILS+1))
		log "minui exited rc=$RC (fail $FAILS); tail:"
		tail -20 /mnt/log/minui-live.log >> "$LOG" 2>/dev/null
		sync
		if [ $FAILS -ge 3 ]; then
			log "minui failing repeatedly — parking with logs flushed (pull the card to read p2)"
			while : ; do sleep 60; done
		fi
		sleep 2
	fi
done
